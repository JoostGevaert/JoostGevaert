---
import TypeTag from "./TypeTag.astro";
import Texture from "./Texture.astro";
import { isoDate } from "../../lib/format";
import type { Post, Texture as TextureKind } from "../../lib/posts";

interface Props { post: Post; texture: TextureKind }
const { post, texture } = Astro.props;
const { title, description, date, type } = post.data;
---
<header class="post-header">
  <Texture kind={texture} strength="card" />
  <div class="meta">
    <time class="label" datetime={isoDate(date)}>{isoDate(date)}</time>
    <TypeTag type={type} />
  </div>
  <h1 class="display">{title}</h1>
  {description && <p class="lede">{description}</p>}
</header>

<style>
  .post-header {
    position: relative;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: var(--space-6) var(--space-5) var(--space-5);
    margin-bottom: var(--space-5);
  }
  .post-header > :not(.texture) { position: relative; }
  .meta { display: flex; align-items: center; gap: var(--space-2); margin-bottom: var(--space-3); }
  h1 { max-width: 20ch; }
  .lede { margin: var(--space-3) 0 0; max-width: 52ch; }
  @media (max-width: 560px) {
    .post-header { padding: var(--space-5) var(--space-4) var(--space-4); }
    h1 { font-size: 34px; }
  }
</style>
