---
// A faint background texture (BRAND.md, Textures), swapped per theme.
// Files are the optimized copies in public/textures/ (npm run textures).
import type { Texture } from "../../lib/posts";
interface Props {
  kind: Texture;
  /** Opacity token: texture-card (post headers) or texture-hero. */
  strength?: "card" | "hero";
}
const { kind, strength = "card" } = Astro.props;
const ext = kind === "drawing" ? "webp" : "svg";
---
<div class:list={["texture", `texture-${kind}`]} style={`--tex-opacity: var(--opacity-texture-${strength})`} aria-hidden="true">
  <img class="tex-light" src={`/textures/${kind}-light.${ext}`} alt="" loading="lazy" decoding="async" />
  <img class="tex-dark" src={`/textures/${kind}-dark.${ext}`} alt="" loading="lazy" decoding="async" />
</div>

<style>
  .texture {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: var(--tex-opacity);
    /* fade in from the left so the title sits on a clean ground */
    mask-image: linear-gradient(90deg, transparent 0%, #000 55%);
  }
  img {
    position: absolute;
    right: 0;
    top: 50%;
    translate: 0 -50%;
    height: 135%;
    width: auto;
    max-width: none;
  }
  .tex-dark { display: none; }
  :global(:root[data-theme="dark"]) .tex-dark { display: block; }
  :global(:root[data-theme="dark"]) .tex-light { display: none; }
</style>
