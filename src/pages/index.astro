---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostList from "../components/blog/PostList.astro";
import Texture from "../components/blog/Texture.astro";
import { getPosts } from "../lib/posts";

const posts = await getPosts();
---

<BaseLayout title="joost.engineer">
  <div class="content-grid gap-y-16">
    <section class="relative isolate col-breakout overflow-clip rounded-lg border border-line bg-surface px-6 py-16 sm:px-10">
      <Texture kind="drawing" strength="hero" />
      <p class="relative max-w-sm text-ink type-lede">
        Joost Gevaert's blog for his (thought) experiments and side projects.
      </p>
    </section>
    <section class="col-breakout flex flex-col gap-2" aria-labelledby="writing">
      <h2 id="writing" class="text-link type-label">
        Writing
      </h2>
      <PostList posts={posts} />
    </section>
  </div>
</BaseLayout>
