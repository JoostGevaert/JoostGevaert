---
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostHeader from "../../components/blog/PostHeader.astro";
import Figure from "../../components/blog/Figure.astro";
import Callout from "../../components/blog/Callout.astro";
import PostLinks from "../../components/blog/PostLinks.astro";
import { getPosts, textureFor } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, texture: textureFor(post, posts) } }));
}
const { post, texture } = Astro.props;
const { Content } = await render(post);
---
<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={`/og/${post.id}.png`}
  imageAlt={`${post.data.title}: social card for joost.engineer`}
  published={post.data.date}
>
  <article>
    <PostHeader post={post} texture={texture} />
    <div data-prose class="max-w-prose">
      <Content components={{ Figure, Callout }} />
      <PostLinks linkedin={post.data.linkedin} repo={post.data.repo} />
    </div>
  </article>
</BaseLayout>
