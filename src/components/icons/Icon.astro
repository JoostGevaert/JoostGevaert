---
// Lucide interface icon at the house stroke (BRAND.md, Icons): currentColor,
// aria-hidden, and a 1.5 px stroke at every display size (non-scaling
// stroke, Lucide's absoluteStrokeWidth).
//
// Sized by its text, not in px: a 1.25em box (about 16 / 20 / 24 px next to
// small / body / headings), flex: none, centered on the text by its flex
// parent. Pass `size` only where there is no text to follow, such as the
// 13 px icons drawn inside the theme switch's SVG.
import { readFileSync } from "node:fs";
import { resolve } from "node:path";

interface Props {
  name: string;
  size?: number;
  class?: string;
}
const { name, size, class: className } = Astro.props;
const raw = readFileSync(
  resolve(process.cwd(), `node_modules/lucide-static/icons/${name}.svg`),
  "utf8",
);
const inner = raw
  .replace(/<!--[\s\S]*?-->/, "")
  .replace(/^[\s\S]*?<svg[^>]*>/, "")
  .replace(/<\/svg>\s*$/, "")
  .replace(
    /<(path|line|polyline|polygon|rect|circle|ellipse)\b/g,
    '<$1 vector-effect="non-scaling-stroke"',
  );
---

<svg
  class:list={[size === undefined && "icon-box", className]}
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={inner}
/>
