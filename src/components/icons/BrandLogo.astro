---
// Another platform's logo, solid and one color (BRAND.md, Brand logos).
// Default 18 px, which balances a 20 px line icon.
import github from "../../../design-system/assets/brand/github.svg?raw";
import linkedin from "../../../design-system/assets/brand/linkedin.svg?raw";

interface Props { brand: "github" | "linkedin"; size?: number; class?: string }
const { brand, size = 18, class: className } = Astro.props;
const d = ({ github, linkedin })[brand].match(/ d="([^"]+)"/)![1];
---
<svg
  class:list={["brand-logo", className]}
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
><path d={d} /></svg>
