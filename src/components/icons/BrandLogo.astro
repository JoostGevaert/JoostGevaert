---
// Another platform's logo, solid and one color (BRAND.md, Brand logos).
// Sized by its text like an icon, a little smaller (1.125em, 18 px beside a
// 20 px line icon) because solid shapes look bigger.
import github from "../../../design-system/assets/brand/github.svg?raw";
import linkedin from "../../../design-system/assets/brand/linkedin.svg?raw";

interface Props {
  brand: "github" | "linkedin";
  class?: string;
}
const { brand, class: className } = Astro.props;
const d = { github, linkedin }[brand].match(/ d="([^"]+)"/)![1];
---

<svg
  class:list={["brand-box", className]}
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
>
  <path d={d} />
</svg>
