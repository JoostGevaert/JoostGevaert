---
// Demo of the chart theme: categorical lines and a diverging/sequential
// cell grid. Used by the post "One token file, a few CSS rules and three data colors".
---

<div class="my-4" data-chart="lines"></div>
<div class="my-4" data-chart="cells"></div>

<script>
  import { renderPlot } from "../../lib/chart/theme";

  const lines = document.querySelector('[data-chart="lines"]');
  const cells = document.querySelector('[data-chart="cells"]');

  const rowers = ["Bow", "Two", "Three", "Stroke"];
  const series = [
    [30, 33, 32, 31, 32, 33, 35, 38],
    [29, 32, 31, 31, 31, 32, 34, 37],
    [30, 32, 32, 30, 31, 33, 35, 39],
    [31, 34, 33, 32, 32, 34, 36, 40],
  ];
  const data = series.flatMap((s, k) =>
    s.map((spm, i) => ({ rower: rowers[k], meters: i * 250 + 250, spm })),
  );

  if (lines)
    renderPlot(lines, ({ plot, Plot, scales, grid }) =>
      plot({
        height: 260,
        y: { label: "Stroke rate (spm)", grid: true, ...grid },
        x: { label: "Distance (m)" },
        color: { ...scales.categorical(rowers), legend: true },
        marks: [
          Plot.ruleY([28]),
          Plot.lineY(data, { x: "meters", y: "spm", stroke: "rower", strokeWidth: 2.5 }),
        ],
      }),
    );

  const grid2 = Array.from({ length: 12 * 8 }, (_, i) => {
    const x = i % 12,
      y = Math.floor(i / 12);
    return { x, y, v: Math.sin(x / 2) * Math.cos(y / 3) };
  });
  if (cells)
    renderPlot(cells, ({ plot, Plot, scales }) =>
      plot({
        height: 220,
        x: { axis: null },
        y: { axis: null },
        color: { ...scales.diverging({ pivot: 0 }), legend: true, label: "Change" },
        marks: [Plot.cell(grid2, { x: "x", y: "y", fill: "v", inset: 0.5 })],
      }),
    );
</script>
