---
// One amount on a map (BRAND.md, Data): seq-teal-1…7, light for little, deep
// for much, in quantile classes. Made-up data on real A5 cells around Amsterdam,
// ported from the design system's SequentialMap component. Fills are the same in
// both themes. Drawn at build time: no script.
import { a5Cells as polygons } from "./a5-cells";
import { classify, pathData } from "../../lib/chart/cells";

const fillClasses = [
  "fill-seq-teal-1",
  "fill-seq-teal-2",
  "fill-seq-teal-3",
  "fill-seq-teal-4",
  "fill-seq-teal-5",
  "fill-seq-teal-6",
  "fill-seq-teal-7",
];
const rampClasses = [
  "bg-seq-teal-1",
  "bg-seq-teal-2",
  "bg-seq-teal-3",
  "bg-seq-teal-4",
  "bg-seq-teal-5",
  "bg-seq-teal-6",
  "bg-seq-teal-7",
];
const classes = classify(polygons, 1.3, fillClasses.length);
---

<div class="flex flex-col gap-2">
  <p class="text-ink type-ui">Bike trips started per A5 cell</p>
  <div class="overflow-clip rounded-sm">
    <svg
      class="block h-auto w-full"
      viewBox="0 0 1000 382"
      role="img"
      aria-label="Map of A5 cells around Amsterdam in seven shades of teal, from few to many bike trips (made-up data)"
    >
      {polygons.map((p, i) => (
        <path d={pathData(p)} class:list={[fillClasses[classes[i]!], "stroke-surface stroke-1"]} />
      ))}
    </svg>
  </div>
  <div class="grid grid-cols-7 gap-0.5" aria-hidden="true">
    {rampClasses.map((fill) => (
      <div class:list={["h-2.5 rounded-sm", fill]} />
    ))}
  </div>
  <div class="flex justify-between text-ink-muted type-small" aria-hidden="true">
    <span>few</span>
    <span>many</span>
  </div>
</div>
