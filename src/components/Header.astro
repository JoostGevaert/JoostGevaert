---
import Logo from "./Logo.astro";
import ThemeSwitch from "./ThemeSwitch.astro";
import Icon from "./icons/Icon.astro";
import BrandLogo from "./icons/BrandLogo.astro";
import { site } from "../site.config";

// Profiles, GitHub and LinkedIn first (BRAND.md, Brand logos: header).
const profiles = [
  { brand: "github" as const, name: "GitHub", url: site.github.url },
  ...(site.linkedin
    ? [{ brand: "linkedin" as const, name: "LinkedIn", url: site.linkedin.url }]
    : []),
];
// 36 px buttons with a 44 px hit area; scale on press.
const iconButtonClasses =
  "group hit-area relative grid size-9 cursor-pointer place-items-center rounded-full text-ink hover:bg-teal-3 hover:text-link motion-safe:transition-transform motion-safe:duration-fast motion-safe:ease-standard motion-safe:active:scale-97";
---

<!-- On the content grid, so the header lines up with the hero, post headers
     and figures (breakout track). -->
<header class="content-grid">
  <div class="col-breakout flex items-center gap-2 border-be border-line py-6 sm:gap-4">
    <!-- py-1: clear space of the j's dot around the logo -->
    <a href="/" class="hit-area me-auto block py-1 leading-none" aria-label="joost.engineer, home">
      <Logo variant="wordmark" id="hdr-wordmark" class="hidden h-6.5 w-auto sm:block" />
      <Logo variant="mark" id="hdr-mark" class="block h-7 w-auto sm:hidden" />
    </a>

    <nav class="me-2 hidden type-ui sm:block" aria-label="Main">
      <a href="/" class="hit-area text-ink no-underline hover:text-link">
        Writing
      </a>
    </nav>

    <!-- gap-2: 36 px buttons 44 px apart, so their 44 px hit areas don't overlap. -->
    <ul class="hidden list-none gap-2 sm:flex" aria-label="Profiles">
      {profiles.map((p) => (
        <li>
          <a class={iconButtonClasses} href={p.url} aria-label={p.name} rel="me noopener">
            <BrandLogo brand={p.brand} />
            <span
              class="pointer-events-none absolute inset-s-1/2 inset-bs-full z-10 mbs-1.5 -translate-x-1/2 rounded-sm border border-line bg-surface px-2 py-0.5 whitespace-nowrap text-ink opacity-0 type-ui group-hover:opacity-100 group-focus-visible:opacity-100 rtl:translate-x-1/2"
              aria-hidden="true"
            >
              {p.name}
            </span>
          </a>
        </li>
      ))}
    </ul>

    <ThemeSwitch />

    <!-- Narrow screens: links and profiles move into the menu, with their names. -->
    <details class="group/menu relative sm:hidden">
      <summary
        class:list={[iconButtonClasses, "no-marker group-open/menu:bg-teal-3"]}
        aria-label="Menu"
      >
        <Icon name="menu" size={20} />
      </summary>
      <!-- Concentric corners: radius-md (12 px) = radius-sm items (6 px) + p-1.5 (6 px). -->
      <ul class="absolute inset-e-0 inset-bs-full z-20 mbs-2 min-w-45 list-none rounded-md border border-line bg-surface p-1.5">
        <li>
          <a
            href="/"
            class="flex min-h-11 items-center gap-2 rounded-sm px-2.5 text-ink no-underline type-ui hover:bg-teal-2 hover:text-link"
          >
            Writing
          </a>
        </li>
        {profiles.map((p) => (
          <li>
            <a
              href={p.url}
              rel="me noopener"
              class="flex min-h-11 items-center gap-2 rounded-sm px-2.5 text-ink no-underline type-ui hover:bg-teal-2 hover:text-link"
            >
              <BrandLogo brand={p.brand} />
              {p.name}
            </a>
          </li>
        ))}
      </ul>
    </details>
  </div>
</header>
