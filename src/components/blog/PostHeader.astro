---
import TypeTag from "./TypeTag.astro";
import Texture from "./Texture.astro";
import { isoDate } from "../../lib/format";
import type { Post, Texture as TextureKind } from "../../lib/posts";

interface Props {
  post: Post;
  texture: TextureKind;
}
const { post, texture } = Astro.props;
const { title, description, date, type } = post.data;
---

<header class="relative isolate col-breakout flex flex-col gap-4 overflow-clip rounded-md border border-line bg-surface px-6 pbs-10 pbe-6 sm:px-10 sm:pbs-16 sm:pbe-10">
  <Texture kind={texture} strength="card" />
  <div class="relative flex items-center gap-2">
    <time class="text-link type-label" datetime={isoDate(date)}>
      {isoDate(date)}
    </time>
    <TypeTag type={type} />
  </div>
  <h1 class="relative max-w-2xl type-display">{title}</h1>
  {description && <p class="relative max-w-prose text-ink-muted type-lede">{description}</p>}
</header>
