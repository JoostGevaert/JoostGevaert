---
// End of a post: pill buttons with logo and word (BRAND.md, Brand logos).
import BrandLogo from "../icons/BrandLogo.astro";
interface Props {
  linkedin?: string;
  repo?: string;
}
const { linkedin, repo } = Astro.props;
const pillClasses =
  "inline-flex items-center gap-2 rounded-pill border border-line bg-surface py-1.5 pe-3.5 ps-3 text-ink no-underline type-ui hover:border-teal-7 hover:bg-teal-2 hover:text-link";
---

{(linkedin || repo) && (
  <div class="flex flex-wrap gap-2 flow-16">
    {linkedin && (
      <a class={pillClasses} href={linkedin} rel="noopener">
        <BrandLogo brand="linkedin" />
        Discuss on LinkedIn
      </a>
    )}
    {repo && (
      <a class={pillClasses} href={`https://github.com/${repo}`} rel="noopener">
        <BrandLogo brand="github" />
        Code on GitHub <span class="text-link type-label">{repo}</span>
      </a>
    )}
  </div>
)}
