---
// End of a post: pill buttons with logo and word (BRAND.md, Brand logos).
import BrandLogo from "../icons/BrandLogo.astro";
interface Props { linkedin?: string; repo?: string }
const { linkedin, repo } = Astro.props;
const pill =
  "inline-flex items-center gap-2 rounded-pill border border-line bg-surface py-1.5 pr-3.5 pl-3 text-ink no-underline type-ui hover:border-teal-7 hover:bg-teal-2 hover:text-link";
---
{(linkedin || repo) && (
  <div class="mt-16 flex flex-wrap gap-2">
    {linkedin && (
      <a class={pill} href={linkedin} rel="noopener"><BrandLogo brand="linkedin" />Discuss on LinkedIn</a>
    )}
    {repo && (
      <a class={pill} href={`https://github.com/${repo}`} rel="noopener">
        <BrandLogo brand="github" />Code on GitHub <span class="text-link type-label">{repo}</span>
      </a>
    )}
  </div>
)}
