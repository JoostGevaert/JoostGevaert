---
// An aside set off by a hairline and a teal rule (borders, not shadows).
interface Props {
  /** Short label in label style, e.g. "Note", "Method", "Result". */
  title?: string;
}
const { title = "Note" } = Astro.props;
---

<aside class="flex flex-col gap-1 rounded-sm border border-s-3 border-teal-6 border-s-brand bg-teal-2 px-6 py-4 flow-6">
  <p class="text-link type-label">{title}</p>
  <div>
    <slot />
  </div>
</aside>
