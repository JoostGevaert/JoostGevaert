---
import Icon from "./icons/Icon.astro";
import BrandLogo from "./icons/BrandLogo.astro";
import { site } from "../site.config";
---
<footer class="site-footer">
  <p class="small">Joost Gevaert's blog for his (thought) experiments and side projects.</p>
  <ul aria-label="Elsewhere">
    <li><a href={site.github.url} rel="me noopener"><BrandLogo brand="github" />GitHub</a></li>
    {site.linkedin && <li><a href={site.linkedin.url} rel="me noopener"><BrandLogo brand="linkedin" />LinkedIn</a></li>}
    <li><a href={site.rss}><Icon name="rss" size={20} />RSS</a></li>
  </ul>
</footer>

<style>
  .site-footer {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--space-5) var(--space-4) var(--space-6);
    border-top: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-5);
    align-items: center;
    justify-content: space-between;
  }
  p { margin: 0; color: var(--ink-muted); }
  ul { display: flex; gap: var(--space-4); list-style: none; margin: 0; padding: 0; }
  a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font: var(--type-ui);
    color: var(--ink);
    text-decoration: none;
  }
  a:hover { color: var(--link); }
</style>
