---
import Icon from "./icons/Icon.astro";
import BrandLogo from "./icons/BrandLogo.astro";
import { site } from "../site.config";

const linkClasses = "inline-flex items-center gap-2 text-ink no-underline type-ui hover:text-link";
---

<footer class="mx-auto flex max-w-300 flex-wrap items-center justify-between gap-x-10 gap-y-4 border-bs border-line px-6 pbs-10 pbe-16">
  <p class="text-ink-muted type-small">
    Joost Gevaert's blog for his (thought) experiments and side projects.
  </p>
  <ul class="flex list-none gap-6" aria-label="Elsewhere">
    <li>
      <a class={linkClasses} href={site.github.url} rel="me noopener">
        <BrandLogo brand="github" />
        GitHub
      </a>
    </li>
    {site.linkedin && (
      <li>
        <a class={linkClasses} href={site.linkedin.url} rel="me noopener">
          <BrandLogo brand="linkedin" />
          LinkedIn
        </a>
      </li>
    )}
    <li>
      <a class={linkClasses} href={site.rss}>
        <Icon name="rss" size={20} />
        RSS
      </a>
    </li>
  </ul>
</footer>
