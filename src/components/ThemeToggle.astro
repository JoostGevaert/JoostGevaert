---
// Three-way theme switch: System (default), Light, Dark.
// Ported from Bedrock.engineer's ThemeToggle (same storage key, roving
// tabindex and keyboard handling), restyled as a radius-pill segmented
// control with words instead of icons (BRAND.md, Iconography).
const options = [
  { value: "auto", label: "System" },
  { value: "light", label: "Light" },
  { value: "dark", label: "Dark" },
];
---
<div
  data-theme-toggle
  class="inline-flex gap-0.5 rounded-pill border border-line bg-surface p-0.5"
  role="radiogroup"
  aria-label="Color theme"
>
  {options.map((o) => (
    <button
      type="button"
      role="radio"
      data-theme={o.value}
      aria-checked="false"
      tabindex="-1"
      class="cursor-pointer rounded-pill border border-transparent px-3 py-1.5 text-ink-muted type-ui transition-colors hover:bg-teal-3 hover:text-ink aria-checked:border-teal-7 aria-checked:bg-teal-4 aria-checked:text-teal-12 motion-reduce:transition-none"
    >
      {o.label}
    </button>
  ))}
</div>

<!-- is:inline so the active state is right before first paint. The page's
     data-theme itself is set earlier by the snippet in BaseLayout's <head>.
     IIFE + init guard so the component can render more than once. -->
<script is:inline>
  (() => {
    const getTheme = () => {
      const s = localStorage.getItem("theme");
      return s === "light" || s === "dark" ? s : "auto";
    };
    const resolve = (t) =>
      t === "auto" ? (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light") : t;

    function applyTheme(theme) {
      document.documentElement.dataset.theme = resolve(theme);
      if (theme === "auto") localStorage.removeItem("theme");
      else localStorage.setItem("theme", theme);
      document.querySelectorAll("[data-theme-toggle] button").forEach((b) => {
        const on = b.dataset.theme === theme;
        b.setAttribute("aria-checked", String(on));
        b.tabIndex = on ? 0 : -1;
      });
    }

    document.querySelectorAll("[data-theme-toggle]:not([data-init])").forEach((root) => {
      root.dataset.init = "";
      const btns = [...root.querySelectorAll("button")];
      btns.forEach((b, i) => {
        b.addEventListener("click", () => applyTheme(b.dataset.theme));
        b.addEventListener("keydown", (e) => {
          const step = { ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1 }[e.key];
          if (!step) return;
          e.preventDefault();
          const next = btns[(i + step + btns.length) % btns.length];
          applyTheme(next.dataset.theme);
          next.focus();
        });
      });
    });

    applyTheme(getTheme());

    if (!window.__themeMediaBound) {
      window.__themeMediaBound = true;
      matchMedia("(prefers-color-scheme: dark)").addEventListener("change", () => {
        if (getTheme() === "auto") applyTheme("auto");
      });
    }
  })();
</script>
