---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { color } from "../lib/tokens";

interface Props {
  title: string;
  description?: string;
  /** Social card path, e.g. /og/my-post.png. */
  image?: string;
  imageAlt?: string;
  /** Set for posts: og:type article with its publication date. */
  published?: Date;
}
const {
  title,
  description = "Joost Gevaert's blog for his (thought) experiments and side projects.",
  image,
  imageAlt,
  published,
} = Astro.props;
const fullTitle = title === "joost.engineer" ? title : `${title} · joost.engineer`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = image && new URL(image, Astro.site);
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content="joost.engineer" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={published ? "article" : "website"} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {published && <meta property="article:author" content="Joost Gevaert" />}
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    {imageUrl && <meta property="og:image:type" content="image/png" />}
    {imageUrl && <meta property="og:image:width" content="1200" />}
    {imageUrl && <meta property="og:image:height" content="630" />}
    {imageUrl && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    <meta name="twitter:card" content={imageUrl ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
    {imageUrl && imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title="joost.engineer" href="/rss.xml" />
    <meta name="theme-color" content={color("bg", "light")} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={color("bg", "dark")} media="(prefers-color-scheme: dark)" />
    <!-- Apply the stored theme before first paint. Every color token is a
         light-dark() value, so the choice is just color-scheme on :root
         (Auto, "light dark", follows the system and is the default);
         data-theme carries the resolved theme as a hook for scripts. -->
    <script is:inline>
      (() => {
        const s = localStorage.getItem("theme");
        const t = s === "light" || s === "dark" ? s : "auto";
        const root = document.documentElement;
        root.style.colorScheme = t === "auto" ? "light dark" : t;
        root.dataset.theme =
          t === "auto"
            ? matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light"
            : t;
      })();
    </script>
  </head>
  <body>
    <a
      class="sr-only rounded-sm border border-line bg-surface px-4 py-2 type-ui focus:not-sr-only focus:absolute focus:inset-s-4 focus:inset-bs-4 focus:z-40"
      href="#main"
    >
      Skip to content
    </a>
    <!-- Sticky: slides out while scrolling down, back in on scrolling up (script below).
         Under reduced motion it hides and shows without sliding. -->
    <div
      data-site-header
      class="sticky inset-bs-0 z-30 bg-bg data-hidden:-translate-y-full motion-safe:transition-transform motion-safe:duration-fast motion-safe:ease-standard"
    >
      <Header />
    </div>
    <!-- Pages lay themselves out on the content grid (col-breakout, col-full). -->
    <main id="main" class="pbs-10 pbe-16">
      <slot />
    </main>
    <Footer />
    <script>
      import "../scripts/popup-link";
    </script>
    <script>
      import { initialHeaderScroll, nextHeaderScroll } from "../lib/header-scroll";

      const header = document.querySelector<HTMLElement>("[data-site-header]");
      if (header) {
        const menu = header.querySelector("details");
        let state = initialHeaderScroll(scrollY);
        let queued = false;

        const show = () => {
          state = { ...state, hidden: false };
          delete header.dataset.hidden;
        };

        const update = () => {
          queued = false;
          state = nextHeaderScroll(state, scrollY, header.offsetHeight);
          // Keep it in view while its menu is open or it holds keyboard focus.
          if (!state.hidden || menu?.open || header.matches(":focus-within")) show();
          else header.dataset.hidden = "";
        };

        addEventListener(
          "scroll",
          () => {
            if (!queued) requestAnimationFrame(update);
            queued = true;
          },
          { passive: true },
        );
        header.addEventListener("focusin", show);
      }
    </script>
  </body>
</html>
