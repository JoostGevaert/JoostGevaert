{
  "font": {
    "sans": {
      "$type": "fontFamily",
      "$value": [
        "Source Sans 3",
        "system-ui",
        "sans-serif"
      ]
    },
    "serif": {
      "$type": "fontFamily",
      "$value": [
        "Source Serif 4",
        "Georgia",
        "serif"
      ]
    },
    "mono": {
      "$type": "fontFamily",
      "$value": [
        "Source Code Pro",
        "ui-monospace",
        "monospace"
      ]
    }
  },
  "type": {
    "display": {
      "$type": "typography",
      "$description": "Post and page titles. Source Sans 3 Bold, balanced wrapping.",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": {
          "value": 44,
          "unit": "px"
        },
        "lineHeight": 1.1,
        "fontWeight": 700,
        "letterSpacing": {
          "value": -0.01,
          "unit": "em"
        }
      }
    },
    "heading": {
      "$type": "typography",
      "$description": "Section headings inside posts.",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": {
          "value": 28,
          "unit": "px"
        },
        "lineHeight": 1.15,
        "fontWeight": 700,
        "letterSpacing": {
          "value": 0,
          "unit": "em"
        }
      }
    },
    "subheading": {
      "$type": "typography",
