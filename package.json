{
  "name": "joost-engineer",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "pnpm tokens:css && astro dev",
    "build": "pnpm tokens:css && astro sync && tsc && astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "lint": "eslint . && stylelint \"src/**/*.{css,astro}\"",
    "format": "prettier --write .",
    "deploy": "gh workflow run deploy.yml --ref main",
    "astro": "astro",
    "tokens:export": "node scripts/export-tokens.mjs",
    "tokens:check": "tz check",
    "tokens:css": "tz build && node scripts/light-dark.mjs",
    "icons": "node scripts/build-icons.mjs",
    "textures": "node scripts/build-textures.mjs",
    "fonts": "node scripts/build-fonts.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.10",
    "@astrojs/mdx": "^8.1.6",
    "@astrojs/rss": "^4.0.19",
    "@fontsource-variable/source-code-pro": "^5.3.1",
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@fontsource/source-code-pro": "^5.3.1",
    "@fontsource/source-sans-3": "^5.3.1",
    "@observablehq/plot": "^0.6.19",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.13",
    "github-slugger": "^2.0.0",
    "lucide-static": "^1.77.0",
    "mdast-util-to-string": "^4.0.0",
    "remark-parse": "^11.0.0",
    "satori": "^0.63.2",
    "sharp": "^0.35.5",
    "simple-icons": "^16.38.0",
    "tailwindcss": "^4.3.5",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0"
  },
  "devDependencies": {
    "@babel/core": "^8.1.2",
    "@babel/eslint-parser": "^8.1.2",
    "@eslint/js": "^10.0.1",
    "@terrazzo/cli": "^2.10.0",
    "@terrazzo/plugin-css": "^2.10.0",
    "@types/node": "^26.6.6",
    "astro-eslint-parser": "^3.2.0",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-better-tailwindcss": "^4.11.0",
    "globals": "^17.14.0",
    "postcss-html": "^2.0.1",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "stylelint": "^18.1.0",
    "svgo": "^4.1.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "engines": {
    "node": ">=22"
  }
}
